# Terraform working directory and state
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log

# Local-only Terraform variables (never commit real values)
**/terraform.tfvars
**/*.auto.tfvars
!**/terraform.tfvars.example

# Credentials, certificates, private keys
*.pem
*.key
*.pfx
*.p12
*.cer
*.credentials

# Local editor / OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
