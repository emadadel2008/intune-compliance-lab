# Terraform working directory and state
**/.terraform/*
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
tfplan
*.plan
crash.log
crash.*.log

# Local-only Terraform variables (never commit real values)
**/terraform.tfvars
**/*.auto.tfvars
*.tfvars
*.tfvars.json
!**/terraform.tfvars.example
!**/terraform.tfvars.json.example

# Local Terraform overrides
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Credentials, certificates, private keys
*.pem
*.key
*.pfx
*.p12
*.cer
*.credentials

# Local editor / OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
